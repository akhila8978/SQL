--- compare the current value and aggregatedd value of window functions---(part to whole) like highest avg month  in year 

select orderid, productid, sales , sum(Sales) over () totalsales, cast(sales as float)/sum(sales) over()*100 from sales.orders

---Avg()---return the avergae of values in each window

--find the average sales foe each department--
avg(coalesce(Sales,0)) over(partition by product)
