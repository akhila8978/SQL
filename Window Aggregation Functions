---Window  Aggregation function----
                 ┌──────────────────────────────┐
                 │  WINDOW AGGREGATE FUNCTIONS   │
                 └──────────────┬───────────────┘
                                │
          ┌─────────────────────┴─────────────────────┐
          │                                           │
   ┌──────▼──────┐                              ┌─────▼─────┐
   │    COUNT    │                              │    SUM    │
   └──────┬──────┘                              └─────┬─────┘
          │                                           │
   Number of rows                              Sum of values
          │                                           │
 COUNT(*) OVER(                                  SUM(Sales) OVER(
 PARTITION BY Product)                            PARTITION BY Product)
          
          ┌────────────────────────────────────────────────┐
          │                                                │
   ┌──────▼──────┐                                  ┌──────▼──────┐
   │     AVG     │                                  │     MIN     │
   └──────┬──────┘                                  └──────┬──────┘
          │                                                │
   Average of values                                Minimum value
          │                                                │
 AVG(Sales) OVER(                                  MIN(Sales) OVER(
 PARTITION BY Product)                              PARTITION BY Product)


                       ┌──────────────┐
                       │     MAX      │
                       └──────┬───────┘
                              │
                       Maximum value
                              │
                       MAX(Sales) OVER(
                       PARTITION BY Product)
SELECT
    Product,
    Sales,

    COUNT(*) OVER(PARTITION BY Product) AS Product_Count,

    SUM(Sales) OVER(PARTITION BY Product) AS Total_Sales,

    AVG(Sales) OVER(PARTITION BY Product) AS Avg_Sales,

    MIN(Sales) OVER(PARTITION BY Product) AS Min_Sales,

    MAX(Sales) OVER(PARTITION BY Product) AS Max_Sales

FROM Sales;


