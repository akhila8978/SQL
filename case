----usecase----


create report of total sales for each category

sales over 50 -- high
sales 21- 50 --- medium
sales 20 or less -- low
sort  categories from sales to lowest


select category,sum(sales) as totalsales from ( select orderid, sales,
case 
    when sales > 50 then 'high'
    when sales > 20 then 'medium'
    else 'low'
End category
from sales.orders) t
group by category  order by totalsales desc;


