10. Practice Queries on the Movies Data
-- a) Rating as percent (expression * number — your query #2)
SELECT title, rating * 10 AS rating_percent
FROM movies JOIN boxoffice ON movies.id = boxoffice.movie_id;

-- b) Movies from even years (modulo)
SELECT title, year FROM movies WHERE year % 2 = 0;

-- c) Titles containing 'Toy'
SELECT title FROM movies WHERE title LIKE 'Toy%';

-- d) Brad Bird or Andrew Stanton movies after 2005
SELECT title, director, year FROM movies
WHERE director IN ('Brad Bird', 'Andrew Stanton') AND year > 2005;

-- e) Short / Medium / Long classification
SELECT title, length_minutes,
  CASE WHEN length_minutes < 95 THEN 'Short'
       WHEN length_minutes <= 110 THEN 'Medium'
       ELSE 'Long' END AS category
FROM movies;
