ORDER BY col ASC	Sort A→Z / small→big	ORDER BY title ASC
ORDER BY col DESC	Sort Z→A / big→small	ORDER BY year DESC
LIMIT n	Keep only first n rows	LIMIT 4
OFFSET m	Skip first m rows (pagination)	LIMIT 5 OFFSET 5
