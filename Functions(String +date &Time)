4. Part Extraction Functions
4.1 DAY / MONTH / YEAR
SELECT orderid,
       creationtime,
       YEAR(creationtime)  AS year,
       MONTH(creationtime) AS month,
       DAY(creationtime)   AS day
FROM sales.orders;
4.2 DATEPART(part, date) — numeric part, more options
datepart(month, orderdate) or datepart(mm, '2025-08-20')

SELECT orderid,
       creationtime,
       DATEPART(year,    creationtime) AS year_dp,
       DATEPART(month,   creationtime) AS month_dp,
       DATEPART(day,     creationtime) AS day_dp,
       DATEPART(hour,    creationtime) AS hour_dp,
       DATEPART(quarter, creationtime) AS quarter_dp,
       DATEPART(week,    creationtime) AS week_dp,
       YEAR(creationtime)  AS year,
       MONTH(creationtime) AS month,
       DAY(creationtime)   AS day
FROM sales.orders;
4.3 DATENAME(part, date) — the part as text
SELECT orderid,
       creationtime,
       DATENAME(month,   creationtime) AS d_name,      -- 'August'
       DATENAME(weekday, creationtime) AS weekday_dn,  -- 'Thursday'
       DATENAME(day,     creationtime) AS day_dn
FROM sales.orders;
4.4 Output datatype cheat-sheet ⚠️
which part
     │
     ├── day, month, year ──► numeric        ──► day() month() year()  /  datepart()
     └── other parts       ──► datepart()    (always numeric, int)
             │
             └── full name  ──► datename()   (always a STRING)
Function	Output datatype
DATEPART	int
DATENAME	string
DATETRUNC	datetime
EOMONTH	date
4.5 DATETRUNC(part, date) — truncate the rest to zero
Keeps the required part as it is; everything below it is reset (day part → 01, time part → 00:00:00).

SELECT orderid,
       creationtime,
       DATETRUNC(minute, creationtime) AS minute_dt,  -- seconds → 00
       DATETRUNC(day,    creationtime) AS day_dt,     -- time → 00:00:00
       DATETRUNC(year,   creationtime) AS year_dt     -- Jan 1, 00:00:00
FROM sales.orders;
Classic use — counting rows per period:

SELECT DATETRUNC(year,  creationtime), COUNT(*) FROM sales.orders GROUP BY DATETRUNC(year,  creationtime);
SELECT DATETRUNC(month, creationtime), COUNT(*) FROM sales.orders GROUP BY DATETRUNC(month, creationtime);
4.6 EOMONTH(date) — last day of the month (returns a date)
SELECT orderid,
       creationtime,
       EOMONTH(creationtime)                        AS endofmonth,
       CAST(DATETRUNC(month, creationtime) AS DATE) AS startofmonth  -- first day of month
FROM sales.orders;
5. Real Use Cases
1. Report of orders per year & month:

SELECT YEAR(orderdate)  AS sortbyyear,
       MONTH(orderdate) AS sortbymonth,
       COUNT(*)         AS nrorders
FROM sales.orders
GROUP BY YEAR(orderdate), MONTH(orderdate);
2. Order counts by month name:

SELECT DATENAME(month, orderdate) AS ordermonth,
       COUNT(*)                   AS nroforders
FROM sales.orders
GROUP BY DATENAME(month, orderdate);
3. Orders placed in February:

SELECT * FROM sales.orders WHERE MONTH(orderdate) = 2;
6. Format & Casting — changing data types
 CAST(value AS data_type)      any → any type, NO formatting
 CONVERT(data_type, value [, style])   any → any type, formats DATETIME only (default style 0)
 FORMAT(value, format [, culture])     any → STRING only, formats date/time AND numbers
6.1 FORMAT(value, format[, culture])
FORMAT(orderdate, 'dd/MM/yyyy')
SELECT orderid,
       creationTime,
       FORMAT(creationTime, 'dd')   AS dd,    -- 20
       FORMAT(creationTime, 'ddd')  AS ddd,   -- Wed
       FORMAT(creationTime, 'dddd') AS dddd   -- Wednesday
FROM sales.orders;
Build a custom display string with concatenation:

SELECT orderid,
       creationTime,
       'Day ' + FORMAT(creationTime, 'ddd  MMM ') +
       ' Q' + DATENAME(quarter, creationTime) + ' ' +
       FORMAT(creationTime, 'YYYY hh:mm:ss tt') AS customerFormat
FROM sales.orders;
-- → 'Day Wed Aug  Q3 2026 06:55:45 PM'
6.2 CONVERT(data_type, value [, style])
CONVERT(INT, '124')                 -- string → int
CONVERT(VARCHAR, orderdate, '34')   -- date → string with style
6.3 CAST(value AS data_type)
SELECT CAST('123' AS INT)           AS string_int,
       CAST(123 AS VARCHAR)         AS int_string,
       CAST('2025-02-23' AS DATE)   AS string_date,
       CAST(creationtime AS DATE)   AS datetime_to_date
FROM sales.orders;
7. DATEADD — add or subtract time
DATEADD(part, interval, date) — use a negative interval to go back.

SELECT orderid,
       orderdate,
       DATEADD(year,  2,  orderdate) AS two_years_later,
       DATEADD(month, 3,  orderdate) AS three_months_later,
       DATEADD(day,  -10, orderdate) AS ten_days_before
FROM sales.orders;
8. DATEDIFF — difference between two dates
DATEDIFF(part, start_date, end_date)

SELECT orderid, orderdate,
       DATEDIFF(year, orderdate, shipdate) AS years_to_ship
FROM sales.orders;
Use case — calculating age:

SELECT employeeid,
       birthdate,
       DATEDIFF(year, birthdate, GETDATE()) AS age
FROM sales.employees;
Use case — average shipping duration per month:

SELECT MONTH(orderdate) AS ordermonth,
       AVG(DATEDIFF(day, orderdate, shipdate)) AS avg_days_ship
FROM sales.orders
GROUP BY MONTH(orderdate);
Use case — time-gap analysis between orders (uses LAG, a window function):

SELECT orderid,
       orderdate AS currentorderdate,
       LAG(orderdate) OVER (ORDER BY orderdate) AS previousorderdate,
       DATEDIFF(day,
                LAG(orderdate) OVER (ORDER BY orderdate),
                orderdate) AS nr_of_days
FROM sales.orders;
9. ISDATE — is this value a valid date?
Returns 1 = valid, 0 = not a date.

SELECT ISDATE('2025-04-23');   -- 1
SELECT ISDATE('123')  AS datecheck;      -- 0
SELECT ISDATE('2023-09-23') AS datecheck; -- 1
