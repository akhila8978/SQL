2.1 CONCAT — join values together
SELECT first_name,
       country,
       CONCAT(first_name, country) AS name_country
FROM dbo.customers;
2.2 UPPER / LOWER — change case
SELECT first_name,
       CONCAT(first_name, country)       AS name_country,
       UPPER(first_name)                 AS upper_name,
       LOWER(first_name)                 AS lower_name
FROM dbo.customers;
2.3 TRIM — removes leading & trailing spaces
-- find rows where the stored value has stray spaces
SELECT first_name
FROM customers
WHERE first_name != Trim(first_name);
2.4 LEN — length of the string
SELECT first_name,
       LEN(first_name) AS len_name
FROM customers;
2.5 REPLACE — replace or remove a substring
-- replace
SELECT '123-456-7890',
       REPLACE('123-456-7890', '-', '/') AS clean_phone;

-- remove (replace with empty string '')
SELECT 'report.txt',
       REPLACE('report.txt', '.txt', '.csv') AS new_filename;
2.6 LEFT / RIGHT — extract from the edges
LEFT(value, n) → first n characters · RIGHT(value, n) → last n characters

SELECT first_name,
       LEFT(TRIM(first_name), 2) AS first_2_char,
       RIGHT(first_name, 2)      AS last_2_char
FROM customers;
2.7 SUBSTRING — extract from the middle
SUBSTRING(value, start, length) — start is 1-based.

SELECT first_name,
       SUBSTRING(first_name, 2, 4) AS sub_name
FROM customers;
-- 'Akhila' → 'khil'  (start at char 2, take 4 chars)
2.8 ROUND & ABS (quick numeric side-note)
SELECT 3.156, ROUND(3.156, 2) AS round_2;   -- 3.160
SELECT -10, ABS(10), ABS(-10);               -- -10, 10, 10
3. Date & Time — The Basics
A timestamp = Date + Time:

 2026-08-20  18:55:45
 └────┬────┘ └───┬──┘
     date       time
 year-month-day  Hours:Minutes:Seconds
Format used by Oracle, PostgreSQL, MySQL.

SELECT orderid, orderdate, shipdate, creationTime
FROM Sales.Orders;

SELECT * FROM Sales.Orders;
